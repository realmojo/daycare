# Supabase — keywordegg 계열과 같은 프로젝트를 쓰고, 테이블만 apt_ 접두사로 나눈다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_BASE_URL=https://apt.keywordegg.com

# 검색엔진 소유확인 (비워 두면 해당 태그가 들어가지 않는다)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# 다음 웹마스터도구가 robots.txt 주석으로 확인하는 문자열 (#DaumWebMasterTool:... 전체)
DAUM_VERIFICATION=

# Google Analytics 측정 ID (G-XXXXXXXXXX). 비워 두면 gtag 를 넣지 않는다
NEXT_PUBLIC_GA_ID=

# ── 공공데이터포털 (관리비 적재용. 사이트 런타임에는 쓰지 않는다) ──
#
# 인증키는 계정당 하나다. 아래 5개 API 에 각각 "활용신청"만 하면 같은 키로 쓴다.
# 전부 자동승인이라 신청 즉시 열린다.
#
#   15057332  공동주택 단지 목록제공 서비스
#   15058453  공동주택 기본 정보제공 서비스
#   15057937  공동주택관리비(공용관리비) 정보제공서비스   ← 주축
#   15059469  공동주택관리비(개별사용료) 정보제공서비스
#   15059160  공동주택관리비(장기수선충당금) 정보서비스
#
# 마이페이지 > 데이터활용 > Open API > 개발계정 상세보기 에서
# "일반 인증키(Decoding)" 를 넣는다.
DATA_GO_KR_SERVICE_KEY=

# 위 상세보기 화면의 "요청주소" 를 그대로 넣는다 (serviceKey·pageNo 제외).
# 서비스가 실재하는 것은 확인했지만 경로를 추측으로 맞히지 못해 비워 둔다.
KAPT_LIST_API_URL=
KAPT_BASIS_API_URL=
KAPT_CMNUSE_COST_API_URL=
KAPT_INDIVIDUAL_COST_API_URL=
KAPT_RESERVE_COST_API_URL=
